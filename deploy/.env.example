# Postgres del bot (utente a privilegi minimi, vedi docs/PANEL_BACKEND.md)
DATABASE_URL=postgresql://panel:CAMBIAMI@host.docker.internal:5432/iyokai
OAUTH2_CLIENT_ID=
OAUTH2_CLIENT_SECRET=
OAUTH2_REDIRECT_URI=https://iyokai.dev/api/auth/callback
# python -c "import secrets;print(secrets.token_urlsafe(48))"
WEB_PANEL_SECRET_KEY=
PANEL_SITE_ORIGIN=https://iyokai.dev
PANEL_COOKIE_SECURE=1
PANEL_TRUST_CF=1
PANEL_AUTO_MIGRATE=0
TUNNEL_TOKEN=

# Stato live sul sito (opzionale): app Twitch (client credentials) e ID canale YouTube (UC...), separati da virgola
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
TWITCH_LOGIN=
YOUTUBE_CHANNEL_IDS=

# Token solo nel backend, mai in public/links.json o panel.json
DISCORD_BOT_TOKEN=
DISCORD_MUSIC_1_TOKEN=
DISCORD_MUSIC_2_TOKEN=
DISCORD_MUSIC_3_TOKEN=
DISCORD_MUSIC_4_TOKEN=
DISCORD_MUSIC_5_TOKEN=
DISCORD_NSFW_TOKEN=
YOKAI_MOD_TOKEN=
# Percorso JSON nel container: montare una policy reale o personalizzare la copia server
PANEL_POLICY_FILE=/srv/policy.example.json
# Segreto distinto >=32 caratteri per bridge pagamenti / bot
PANEL_BILLING_BRIDGE_SECRET=

# Private adapter inside the running bot; never expose its port publicly
PANEL_BOT_BRIDGE_URL=
PANEL_BOT_BRIDGE_SECRET=

# Private JSON files (mount read-only into the API container)
PANEL_SITE_SETTINGS_FILE=/srv/site-settings.example.json
PANEL_COMMERCE_FILE=/srv/commerce.example.json
# Fernet keys, first is current; older comma-separated keys allow rotation.
# Generate privately: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
PANEL_DATA_KEYS=
